# Copie para .env e troque as senhas. O .env não vai para o Git.

# Banco (Docker Compose e ferramentas do notebook)
POSTGRES_DB=mq3
POSTGRES_USER=mq3
POSTGRES_PASSWORD=troque-isto
# Senha do usuário só leitura que o Grafana Cloud usa
GRAFANA_PG_SENHA=troque-isto-tambem

# Alerta pelo Telegram quando o modelo classifica um sopro como sob_efeito (opcional).
# Crie um bot com o @BotFather e pegue o chat_id em https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Senha do admin do Grafana local (perfil local do Compose; só em 127.0.0.1)
GRAFANA_ADMIN_SENHA=troque-isto-tambem

# Agente PDC (Grafana Cloud → Connections → Private data source connect)
GCLOUD_PDC_SIGNING_TOKEN=
GCLOUD_PDC_CLUSTER=
GCLOUD_HOSTED_GRAFANA_ID=

# Publicação do dashboard (service account com papel Editor)
GRAFANA_URL=https://SUA-STACK.grafana.net
GRAFANA_TOKEN=
